# White regression
reg_white <- glm(
  everSuspended ~
    lnTotalIncome +
    momCollege +
    dadCollege +
    motherBirthAge +
    motherJob +
    fatherJob +
    siblings +
    hasMaleGuardian +
    hasFemaleGuardian,
  data = subset(df_clean, isBlHs == 0),
  family = binomial(link = "logit")
)

# Minority regression
reg_minority <- glm(
  everSuspended ~
    lnTotalIncome +
    momCollege +
    dadCollege +
    motherBirthAge +
    motherJob +
    fatherJob +
    siblings +
    hasMaleGuardian +
    hasFemaleGuardian,
  data = subset(df_clean, isBlHs == 1),
  family = binomial(link = "logit")
)

# Pooled regression
reg_pooled <- glm(
  everSuspended ~
    lnTotalIncome +
    momCollege +
    dadCollege +
    motherBirthAge +
    motherJob +
    fatherJob +
    siblings +
    hasMaleGuardian +
    hasFemaleGuardian,
  data = df_clean,
  family = binomial(link = "logit")
)

summary(reg_white)
summary(reg_minority)
summary(reg_pooled)



